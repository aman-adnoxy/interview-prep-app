      "stages": [
        {
          "id": "sql-relational-foundations",
          "title": "SQL and Relational Foundations",
          "description": "Query fundamentals, relational modeling, joins, aggregation, NULL behavior, normalization, and advanced SQL.",
          "order": 1
        },
        {
          "id": "transactions-concurrency",
          "title": "Transactions and Concurrency",
          "description": "ACID, isolation, locking, anomalies, safe retries, and concurrent updates.",
          "order": 2
        },
        {
          "id": "indexes-query-performance",
          "title": "Indexes and Query Performance",
          "description": "Index structures, index families, composite design, query plans, and index selection.",
          "order": 3
        },
        {
          "id": "database-internals",
          "title": "Database Internals",
          "description": "Storage pages, execution internals, MVCC, memory, and engine behavior.",
          "order": 4
