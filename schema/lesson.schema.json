{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aman-adnoxy/interview-prep/blob/main/schema/lesson.schema.json",
  "title": "Interview Prep Lesson",
  "description": "Schema for a complete section-based interview-preparation lesson, its knowledge-check quiz, and separate open-ended interview scenarios.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "topicId",
    "sectionId",
    "title",
    "difficulty",
    "estimatedMinutes",
    "questionCount",
    "learningObjectives",
    "mentalModel",
    "concepts",
    "tradeoffsAndPitfalls",
    "revisionSheet",
    "questions",
    "interviewScenarios"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "topicId": {
      "$ref": "#/$defs/id"
    },
    "sectionId": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "questionCount": {
      "type": "integer",
      "minimum": 1
    },
    "learningObjectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mentalModel": {
      "type": "string",
      "minLength": 1
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "explanation",
          "examples"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "examples": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/example"
            }
          }
        }
      }
    },
    "tradeoffsAndPitfalls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "revisionSheet": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/singleSelectQuestion"
          },
          {
            "$ref": "#/$defs/multiSelectQuestion"
          },
          {
            "$ref": "#/$defs/trueFalseQuestion"
          }
        ]
      }
    },
    "interviewScenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "prompt",
          "skillsTested",
          "strongAnswerPoints",
          "pitfalls",
          "referenceAnswer"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "skillsTested": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "strongAnswerPoints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "pitfalls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "referenceAnswer": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "content"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "sql",
            "code",
            "table",
            "execution_plan",
            "scenario",
            "text"
          ]
        },
        "title": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "baseQuestion": {
      "type": "object",
      "required": [
        "id",
        "type",
        "prompt",
        "explanation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string"
        }
      }
    },
    "singleSelectQuestion": {
      "allOf": [
        {
          "$ref": "#/$defs/baseQuestion"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "prompt",
            "options",
            "correctOptionId",
            "explanation"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "single_select"
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "options": {
              "$ref": "#/$defs/options"
            },
            "correctOptionId": {
              "type": "string",
              "minLength": 1
            },
            "explanation": {
              "type": "string",
              "minLength": 1
            },
            "hint": {
              "type": "string"
            }
          }
        }
      ]
    },
    "multiSelectQuestion": {
      "allOf": [
        {
          "$ref": "#/$defs/baseQuestion"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "prompt",
            "options",
            "correctOptionIds",
            "explanation"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "multi_select"
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "options": {
              "$ref": "#/$defs/options"
            },
            "correctOptionIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "explanation": {
              "type": "string",
              "minLength": 1
            },
            "hint": {
              "type": "string"
            }
          }
        }
      ]
    },
    "trueFalseQuestion": {
      "allOf": [
        {
          "$ref": "#/$defs/baseQuestion"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "prompt",
            "correctAnswer",
            "explanation"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "true_false"
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "correctAnswer": {
              "type": "boolean"
            },
            "explanation": {
              "type": "string",
              "minLength": 1
            },
            "hint": {
              "type": "string"
            }
          }
        }
      ]
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
