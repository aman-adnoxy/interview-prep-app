{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aman-adnoxy/interview-prep/blob/main/schema/lesson.schema.json",
  "title": "Interview Prep Lesson",
  "description": "Canonical version 2 lesson contract. Structural correctness is supplemented by semantic validation in scripts/validate-content.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "topicId",
    "sectionId",
    "title",
    "difficulty",
    "estimatedMinutes",
    "learningObjectives",
    "mentalModel",
    "concepts",
    "tradeoffsAndPitfalls",
    "revisionSheet",
    "questions",
    "interviewScenarios"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "topicId": {
      "$ref": "#/$defs/id"
    },
    "sectionId": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "learningObjectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mentalModel": {
      "$ref": "#/$defs/paragraphBlock"
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "blocks"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/block"
            }
          }
        }
      }
    },
    "tradeoffsAndPitfalls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "revisionSheet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/singleSelectQuestion"
          },
          {
            "$ref": "#/$defs/multiSelectQuestion"
          },
          {
            "$ref": "#/$defs/trueFalseQuestion"
          }
        ]
      }
    },
    "interviewScenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interviewScenario"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "paragraphBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/paragraphBlock"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "kind",
            "title",
            "content"
          ],
          "properties": {
            "type": {
              "const": "callout"
            },
            "kind": {
              "enum": [
                "info",
                "tip",
                "warning",
                "pitfall"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "content": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "language",
            "source"
          ],
          "properties": {
            "type": {
              "const": "code"
            },
            "language": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "columns",
            "rows"
          ],
          "properties": {
            "type": {
              "const": "table"
            },
            "title": {
              "type": "string"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "diagramType",
            "alt",
            "nodes",
            "edges"
          ],
          "properties": {
            "type": {
              "const": "diagram"
            },
            "diagramType": {
              "enum": [
                "btree"
              ]
            },
            "title": {
              "type": "string"
            },
            "alt": {
              "type": "string",
              "minLength": 1
            },
            "nodes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "to"
                ],
                "properties": {
                  "from": {
                    "$ref": "#/$defs/id"
                  },
                  "to": {
                    "$ref": "#/$defs/id"
                  }
                }
              }
            },
            "highlightedNodeIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "title",
            "steps"
          ],
          "properties": {
            "type": {
              "const": "steps"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "title",
                  "description"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "problem",
            "reasoning",
            "outcome"
          ],
          "properties": {
            "type": {
              "const": "worked_example"
            },
            "problem": {
              "type": "string",
              "minLength": 1
            },
            "reasoning": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "outcome": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "prompt",
            "answer",
            "explanation"
          ],
          "properties": {
            "type": {
              "const": "checkpoint"
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "answer": {
              "type": "string",
              "minLength": 1
            },
            "explanation": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "singleSelectQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "prompt",
        "options",
        "correctOptionId",
        "explanation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "single_select"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "correctOptionId": {
          "$ref": "#/$defs/id"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string"
        }
      }
    },
    "multiSelectQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "prompt",
        "options",
        "correctOptionIds",
        "explanation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "multi_select"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "correctOptionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string"
        }
      }
    },
    "trueFalseQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "prompt",
        "correctAnswer",
        "explanation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "true_false"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "correctAnswer": {
          "type": "boolean"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string"
        }
      }
    },
    "interviewScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prompt",
        "skillsTested",
        "strongAnswerPoints",
        "pitfalls",
        "referenceAnswer"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "skillsTested": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "strongAnswerPoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pitfalls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "referenceAnswer": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
